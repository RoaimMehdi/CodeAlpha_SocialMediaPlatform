# Database
DB_ENGINE=django.db.backends.mysql
DB_NAME=connectly_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Security
SECRET_KEY=django-insecure-dev-key-do-not-use-in-production
DEBUG=True

# CORS
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Media
MEDIA_URL=/media/
MEDIA_ROOT=media/